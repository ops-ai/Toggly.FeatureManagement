{
  "name": "@ops-ai/toggly-koa",
  "version": "0.2.0",
  "description": "Toggly feature flags Koa middleware",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "toggly",
    "feature-flags",
    "feature-toggles",
    "koa",
    "koa-middleware",
    "ab-testing",
    "experimentation",
    "feature-management"
  ],
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Node/toggly-koa"
  },
  "homepage": "https://docs.toggly.io/sdks/nodejs",
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "koa": "^2.0.0"
  },
  "dependencies": {
    "@ops-ai/toggly-node-core": "workspace:^"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.28.0",
    "koa": "^2.16.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
