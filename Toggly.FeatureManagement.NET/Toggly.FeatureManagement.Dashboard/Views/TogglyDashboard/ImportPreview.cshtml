@model DashboardImportPreviewViewModel
@{ Layout = "_Layout"; var mount = (string?)ViewData["DashboardMount"] ?? ""; var basePath = $"{Context.Request.PathBase}{mount}"; }
<h1>Import preview</h1><section class="card"><form method="post" action="@basePath/import/apply"><input type="hidden" name="__RequestVerificationToken" value="@ViewData["AntiforgeryToken"]" /><input type="hidden" name="payload" value="@Model.Payload" /><input type="hidden" name="fingerprint" value="@Model.Fingerprint" /><input type="hidden" name="expectedRevision" value="@Model.ExpectedRevision" /><h2>Add @Model.AddKeys.Count features</h2>@if (Model.AddKeys.Any()) { <ul>@foreach (var key in Model.AddKeys) { <li><label><input type="checkbox" name="selectedAddKeys" value="@key" checked /> @key</label></li> }</ul> } else { <p>No new features.</p> }<h2>Skip @Model.IdenticalKeys.Count identical features</h2>@if (Model.IdenticalKeys.Any()) { <ul>@foreach (var key in Model.IdenticalKeys) { <li>@key</li> }</ul> }<h2>Existing-key conflicts</h2>@if (Model.ConflictKeys.Any()) { <p>Select a feature only when replacing its editable fields and rules is intended.</p><ul>@foreach (var key in Model.ConflictKeys) { <li><label><input type="checkbox" name="selectedUpdateKeys" value="@key" /> @key</label></li> }</ul> } else { <p>No conflicts.</p> }<button class="button" type="submit">Apply selected changes</button><a href="@basePath/import">Cancel</a></form></section>
