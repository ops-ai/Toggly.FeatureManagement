{
  "name": "@ops-ai/react-feature-flags-toggly",
  "version": "1.11.2",
  "description": "Provides feature flags support for React applications allowing you to enable and disable features easily. Can be used with or without Toggly.io.",
  "scripts": {
    "build": "node scripts/clean.mjs && node scripts/build.mjs && node scripts/remove-intermediate-types.mjs && node scripts/normalize-distribution.mjs",
    "test": "jest --coverage",
    "test:consumers": "node consumer-fixtures/verify.mjs",
    "test:watch": "jest --watch"
  },
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.React"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://docs.toggly.io/sdks/javascript/react",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-typescript": "^11.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^18.0.28",
    "@types/ws": "^8.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "react": "^18.2.0",
    "rollup": "^3.18.0",
    "rollup-plugin-dts": "^5.2.0",
    "ts-jest": "^29.0.0",
    "tslib": "^2.5.0",
    "typescript": "^4.9.5",
    "ws": "^8.0.0"
  },
  "dependencies": {
    "@ops-ai/toggly-hooks-types": "^1.4.5",
    "@ops-ai/toggly-local-gates": "^1.0.1",
    "@ops-ai/toggly-signed-defs": "^1.2.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    }
  },
  "type": "module",
  "keywords": [
    "toggly",
    "feature-flags",
    "feature-management"
  ],
  "publishConfig": {
    "access": "public"
  }
}
