@{ Layout = "_Layout"; var mount = (string?)ViewData["DashboardMount"] ?? ""; var basePath = $"{Context.Request.PathBase}{mount}"; }
<h1>Import and export</h1><div asp-validation-summary="All" class="validation-summary" tabindex="-1" role="alert"></div><section class="card"><p>Download a portable backup of the authoritative catalog.</p><a class="button" href="@basePath/export">Export catalog</a></section><section class="card"><h2>Import catalog</h2><p>Preview adds without writing. Existing feature keys are kept unchanged.</p><form method="post" enctype="multipart/form-data" action="@basePath/import/preview"><input type="hidden" name="__RequestVerificationToken" value="@ViewData["AntiforgeryToken"]" /><label>Catalog JSON <input type="file" name="catalog" accept="application/json,.json" required /></label><button type="submit">Preview import</button></form></section>
