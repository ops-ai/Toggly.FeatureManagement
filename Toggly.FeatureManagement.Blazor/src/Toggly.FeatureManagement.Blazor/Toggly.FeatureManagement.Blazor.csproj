<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <Description>Scoped Blazor feature gates and browser integration for Toggly.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Toggly.FeatureManagement.Client/src/Toggly.FeatureManagement.Client/Toggly.FeatureManagement.Client.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- Match Microsoft.AspNetCore.Components package versions to each TFM. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.33" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.33" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.22" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>
</Project>
