{
  "name": "@ops-ai/toggly-node-core",
  "version": "0.13.1",
  "description": "Core Toggly feature flags SDK for Node.js - zero browser dependencies",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "toggly",
    "nodejs",
    "server-side",
    "feature-management",
    "experimentation",
    "a-b-testing"
  ],
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "homepage": "https://docs.toggly.io/sdks/nodejs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Node/toggly-node-core"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "proto",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ops-ai/toggly-eval": "^2.1.1",
    "@ops-ai/toggly-hooks-types": "^1.4.6",
    "@ops-ai/toggly-segments": "^0.1.0",
    "ws": "^8.22.1"
  },
  "optionalDependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.7.15"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.7.15",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
