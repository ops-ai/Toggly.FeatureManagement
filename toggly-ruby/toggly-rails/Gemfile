# frozen_string_literal: true

source "https://rubygems.org"

gemspec

gem "toggly", path: "../toggly"

group :development, :test do
  gem "parallel", "~> 1.27"
  # Ruby 4 no longer ships OpenStruct as a default gem; the Rails specs use it
  # to construct request users and controller fixtures.
  gem "ostruct", "~> 0.6"
  gem "rails", ENV.fetch("RAILS_VERSION", ">= 7.0")
  # json 3 removed `quirks_mode`; Rails 7.0 / 7.1 / 8.0 ActiveSupport still
  # pass it to JSON.generate. Pin 2.x so the retained Rails floor hosts keep
  # working in this Gemfile matrix (SDK itself has no json dependency).
  gem "json", "~> 2.7"
  gem "rake", "~> 13.0"
  gem "rspec", "~> 3.12"
  gem "rspec-rails", "~> 6.0"
  gem "rubocop", "~> 1.90", require: false
  gem "rubocop-rspec", "~> 2.24", require: false
  gem "simplecov", "~> 1.2", require: false
  gem "sqlite3", "~> 2.9"
  gem "webmock", "~> 3.26"
end
