{
  "name": "@ops-ai/toggly-docusaurus-plugin",
  "version": "0.6.1",
  "description": "Docusaurus plugin and React bindings for Toggly feature flag gating",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "toggly",
    "docusaurus",
    "feature-flags",
    "react",
    "documentation"
  ],
  "author": "Toggly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://github.com/ops-ai/Toggly.FeatureManagement#readme",
  "dependencies": {
    "glob": "^10.3.10"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/webpack": "^5.28.0",
    "@types/ws": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "webpack": "^5.104.1",
    "ws": "^8.0.0"
  }
}
