{
  "name": "@ops-ai/toggly-signed-defs",
  "version": "1.2.1",
  "description": "Shared ES256 signed-definitions verification for Toggly SDKs (browser and Node)",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc && tsc -p tsconfig.esm.json && node scripts/finalize-esm.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "toggly",
    "feature-flags",
    "signed-definitions",
    "es256",
    "jwks"
  ],
  "author": {
    "name": "Toggly",
    "email": "hello@toggly.io"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "toggly-signed-defs"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://github.com/ops-ai/Toggly.FeatureManagement/tree/develop/toggly-signed-defs#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
