<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net6.0 / netstandard2.1 omitted: require BCL shims (CancelAsync, ObjectDisposedException.ThrowIf,
         Enumerable.Order, System.Text.Json inbox APIs) that would change more than TFM metadata. -->
    <TargetFrameworks>net7.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Toggly</Authors>
    <Description>Verified frontend feature evaluation for .NET client applications.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ops-ai/Toggly.FeatureManagement</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Toggly.FeatureManagement.Client.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
