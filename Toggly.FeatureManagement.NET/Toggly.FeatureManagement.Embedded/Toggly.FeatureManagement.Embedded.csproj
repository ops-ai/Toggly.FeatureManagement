<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net6/net7 need source changes (collection expressions, CancelAsync); keep net8+ only. -->
    <TargetFrameworks>net8.0;net9.0;net10.0$(TogglyNet11Tfm)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Toggly.FeatureManagement.Embedded</PackageId>
    <Description>Offline embedded feature-management runtime for Toggly.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Toggly.FeatureManagement\Toggly.FeatureManagement.csproj" />
    <ProjectReference Include="..\Toggly.FeatureManagement.Catalog\Toggly.FeatureManagement.Catalog.csproj" />
  </ItemGroup>
  <!-- Azure.Core 1.64 (via core) requires System.Text.Json >= 10.0.10. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0' OR '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="System.Text.Json" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
    <None Include="..\README.md" Pack="true" PackagePath="" Link="README.md" />
  </ItemGroup>
</Project>
