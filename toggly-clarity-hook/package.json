  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://github.com/ops-ai/Toggly.FeatureManagement/tree/develop/toggly-clarity-hook#readme",
  "dependencies": {
    "@ops-ai/toggly-hooks-types": "^1.1.0"
  },
  "devDependencies": {
