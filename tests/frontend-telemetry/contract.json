  "policy": {
    "endpoint": "https://metrics.toggly.io/api/frontend/telemetry",
    "flushIntervalMs": 45000,
    "minimumIntervalMs": 30000,
    "maximumIntervalMs": 60000,
    "jitterFraction": 0.2,
    "maxEnvelopeBytes": 49152,
    "maxBufferedBytes": 262144,
    "maxEntries": 2000,
    "maxVariantsPerFeature": 16,
    "maxValue": 1000000,
    "timeoutMs": 5000,
    "retryDelaysMs": [
      30000,
      60000
    ],
    "expiryMs": 300000,
    "ackStatus": 202,
    "retryStatuses": [
      429,
      503
    ],
    "dropStatuses": [
      200,
      204,
      400,
      401,
      403,
      413,
      500
    ],
    "variantPattern": "^[A-Za-z0-9_-]{1,64}$"
  },
