@model DashboardFeatureInput
@{ Layout = "_Layout"; var mount = (string?)ViewData["DashboardMount"] ?? ""; var basePath = $"{Context.Request.PathBase}{mount}"; }
<section class="card"><h1>Delete @Model.Name?</h1><p>This feature will stop evaluating immediately. This cannot be undone.</p><form method="post" action="@basePath/features/delete">@Html.AntiForgeryToken()<input type="hidden" name="key" value="@Model.Key" /><input type="hidden" asp-for="ExpectedRevision" /><button class="danger" type="submit">Delete feature</button><a href="@basePath/features/edit?key=@Uri.EscapeDataString(Model.Key)">Cancel</a></form></section>
