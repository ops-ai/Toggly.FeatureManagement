{
  "name": "@ops-ai/toggly-cloudflare-worker",
  "version": "0.4.1",
  "description": "Cloudflare Worker for enforcing Toggly feature flag gating at the edge",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./telemetry": "./src/telemetry/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "npm run test:node && npm run test:workerd",
    "test:node": "vitest run --config vitest.config.mts",
    "test:workerd": "vitest run --config vitest.workerd.config.mts",
    "clean": "rm -rf .wrangler dist"
  },
  "keywords": [
    "toggly",
    "cloudflare",
    "workers",
    "edge",
    "feature-flags"
  ],
  "author": "Toggly",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "5.20261102.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": ">=22"
  }
}
