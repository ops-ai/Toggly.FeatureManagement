{
  "name": "toggly-embedded-dashboard-browser-tests",
  "private": true,
  "scripts": {
    "test": "npm run test:js && playwright test",
    "test:js": "c8 --allowExternal --reporter=text --reporter=lcov --report-dir=../Toggly.FeatureManagement.Dashboard/coverage --include=**/Toggly.FeatureManagement.Dashboard/Assets/dashboard.js node --test --test-concurrency=1 js/dashboard.test.mjs && node js/rewrite-lcov-paths.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "c8": "10.1.3",
    "jsdom": "26.1.0"
  }
}
