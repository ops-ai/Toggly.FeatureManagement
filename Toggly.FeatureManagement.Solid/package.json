{
  "name": "@ops-ai/solid-feature-flags-toggly",
  "version": "0.2.0",
  "description": "Native reactive feature flags for SolidJS with signed definitions, targeting and declarative gates.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "node": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/npm-cli.test.mjs && vitest run",
    "test:coverage": "node --test tests/npm-cli.test.mjs && vitest run --coverage",
    "test:host": "npm run build && node tests/install-host.mjs && cd tests/host && node verify.mjs"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@ops-ai/toggly-hooks-types": "^1.4.5",
    "@ops-ai/toggly-local-gates": "^1.0.1",
    "@ops-ai/toggly-signed-defs": "^1.2.6",
    "@ops-ai/toggly-node-core": "^0.9.1"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^26.1.0",
    "solid-js": "^1.9.9",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.11"
  },
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Solid"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://docs.toggly.io/sdks/javascript/solid",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "solidjs",
    "feature-flags",
    "feature-toggles",
    "toggly",
    "feature-management"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
