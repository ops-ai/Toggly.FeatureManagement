{
  "name": "@ops-ai/nuxt-toggly-core",
  "version": "1.3.1",
  "description": "Core feature flag utilities for Nuxt",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "toggly",
    "nuxt",
    "typescript"
  ],
  "author": "OpsAI <support@ops.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Nuxt/nuxt-toggly-core"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://toggly.io",
  "dependencies": {
    "@ops-ai/toggly-local-gates": "file:../../toggly-local-gates"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "unbuild": "^3.4.0",
    "vitest": "^3.0.4",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
