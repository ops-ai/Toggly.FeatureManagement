{
  "name": "@ops-ai/nuxt-toggly-client",
  "version": "1.0.1",
  "description": "Client-side feature flag composables and components for Nuxt/Vue 3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "toggly",
    "nuxt",
    "vue",
    "vue3",
    "composables",
    "typescript"
  ],
  "author": "OpsAI <support@ops.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Nuxt/nuxt-toggly-client"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://toggly.io",
  "dependencies": {
    "@ops-ai/nuxt-toggly-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^3.0.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.19.0",
    "happy-dom": "^20.0.2",
    "typescript": "^5.7.3",
    "unbuild": "^3.4.0",
    "vitest": "^3.0.4",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
