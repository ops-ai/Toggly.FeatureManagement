{
  "name": "@ops-ai/toggly-sveltekit",
  "version": "0.1.0",
  "description": "Request-scoped feature flags and signed SSR hydration for SvelteKit",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": null,
      "import": "./dist/server.js"
    },
    "./Feature.svelte": "./src/Feature.svelte"
  },
  "files": [
    "dist",
    "src/Feature.svelte"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:host": "node scripts/test-host.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@ops-ai/toggly-node-core": "^0.9.1",
    "@ops-ai/toggly-hooks-types": "^1.4.5",
    "@ops-ai/toggly-signed-defs": "^1.2.6",
    "@ops-ai/toggly-local-gates": "^1.0.1"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.55.0",
    "svelte": "^5.53.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "vite": "^7.3.1",
    "ws": "^8.18.3",
    "svelte-check": "^4.4.5"
  },
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "homepage": "https://docs.toggly.io/sdks/javascript/sveltekit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.SvelteKit"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "keywords": [
    "toggly",
    "feature-flags",
    "feature-toggles",
    "feature-management",
    "svelte",
    "sveltekit"
  ],
  "publishConfig": {
    "access": "public"
  }
}
