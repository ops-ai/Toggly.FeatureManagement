{
  "name": "@ops-ai/remix-toggly-server",
  "version": "1.4.4",
  "description": "Server-side utilities for Toggly Remix SDK - loaders, actions, and server utilities",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "remix",
    "feature-flags",
    "feature-toggles",
    "toggly",
    "server",
    "loader",
    "action",
    "feature-management"
  ],
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Remix/remix-toggly-server"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://docs.toggly.io/sdks/remix/server",
  "dependencies": {
    "@ops-ai/remix-toggly-core": "^1.4.1",
    "@ops-ai/toggly-local-gates": "^1.0.1",
    "ws": "^8.0.0",
    "@ops-ai/toggly-signed-defs": "^1.2.3"
  },
  "peerDependencies": {
    "@remix-run/node": ">=2.0.0",
    "@remix-run/server-runtime": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@remix-run/node": {
      "optional": true
    },
    "@remix-run/server-runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@remix-run/node": "^2.0.0",
    "@remix-run/server-runtime": "^2.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/ws": "^8.0.0",
    "jest": "^29.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "tsup": "^8.5.1",
    "ts-jest": "^29.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "ws": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
