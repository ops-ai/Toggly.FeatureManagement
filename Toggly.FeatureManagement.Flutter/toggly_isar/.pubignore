# When a .pubignore exists, `dart pub publish` uses it INSTEAD of .gitignore to
# decide what to exclude. This is intentional: `*.g.dart` is git-ignored (kept
# out of source control and regenerated via build_runner), but the generated
# Isar code MUST be present in the published package so consumers can compile
# without running build_runner. The release workflow runs build_runner before
# publishing so the generated files exist in the archive.
#
# Exclude only local/dev artifacts here; do NOT exclude *.g.dart.
# Because .pubignore replaces .gitignore for this directory, build/transient
# artifacts must be re-listed here or they get bundled into the archive.
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
coverage/
*.iml
example/.dart_tool/
example/build/

# Isar native core libraries downloaded for desktop tests (never publish these)
libisar.dylib
libisar.so
isar.dll
isar_*.dll
