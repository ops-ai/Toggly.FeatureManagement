@model DashboardFeatureInput
@{
    var mount = (string?)ViewData["DashboardMount"] ?? "";
    var basePath = $"{Context.Request.PathBase}{mount}";
    var isNew = Model.IsNew;
}
<form method="post" action="@(isNew ? basePath + "/features/create" : basePath + "/features/save")" class="card form-card" data-unsaved-warning>
    <input type="hidden" name="__RequestVerificationToken" value="@ViewData["AntiforgeryToken"]" />
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input type="hidden" asp-for="ExpectedRevision" />
    <input type="hidden" asp-for="IsNew" />
    <label>Name<input asp-for="Name" autocomplete="off" /></label><span asp-validation-for="Name"></span>
    <label>Key<input asp-for="Key" autocomplete="off" readonly="@(!isNew)" /></label><span asp-validation-for="Key"></span>
    <label>Description<textarea asp-for="Description" rows="4"></textarea></label><span asp-validation-for="Description"></span>
    <label>Tags <small>Separate tags with commas.</small><input asp-for="Tags" /></label>
    <label>User rule combination <select asp-for="RequirementType"><option value="Any">Any rule matches</option><option value="All">All rules match</option></select></label>
    <label>Entity context kind <input asp-for="ContextKind" /></label>
    <label>Entity rule combination <select asp-for="ContextRequirementType"><option value="">Use user combination</option><option value="Any">Any rule matches</option><option value="All">All rules match</option></select></label>
    <fieldset><legend>Rules</legend><p>Add the filter rows needed for this feature. User and web rules use Requirement type; entity-property rules use Context requirement type.</p>
    @for (var index = 0; index < Math.Max(1, Model.Rules.Count); index++) { var rule = Model.Rules.Count > index ? Model.Rules[index] : new DashboardRuleInput(); <div class="rule-row"><label>Type <select name="Rules[@index].Name"><option value="Percentage" selected="@(rule.Name == "Percentage")">Percentage</option><option value="Targeting" selected="@(rule.Name == "Targeting")">Users/groups</option><option value="TimeWindow" selected="@(rule.Name == "TimeWindow")">Schedule</option><option value="ContextProperty" selected="@(rule.Name == "ContextProperty")">Entity property</option><option value="BrowserFamily" selected="@(rule.Name == "BrowserFamily")">Browser</option><option value="BrowserLanguage" selected="@(rule.Name == "BrowserLanguage")">Language</option><option value="OS" selected="@(rule.Name == "OS")">Operating system</option><option value="DeviceType" selected="@(rule.Name == "DeviceType")">Device</option><option value="CountryFamily" selected="@(rule.Name == "CountryFamily")">Country</option><option value="UserClaims" selected="@(rule.Name == "UserClaims")">Claim</option></select></label><label>Values <input name="Rules[@index].Values" value="@rule.Values" /></label><label>Users <input name="Rules[@index].Users" value="@rule.Users" /></label><label>Groups <input name="Rules[@index].Groups" value="@rule.Groups" /></label><label>Percentage <input name="Rules[@index].Percentage" value="@rule.Percentage" /></label><label>Start <input name="Rules[@index].Start" value="@rule.Start" /></label><label>End <input name="Rules[@index].End" value="@rule.End" /></label><label>Claim <input name="Rules[@index].Claim" value="@rule.Claim" /></label><label>Value <input name="Rules[@index].Value" value="@rule.Value" /></label><label>Context kind <input name="Rules[@index].ContextKind" value="@rule.ContextKind" /></label><label>Property <input name="Rules[@index].Property" value="@rule.Property" /></label><label>Operator <select name="Rules[@index].Operator"><option value="eq">eq</option><option value="neq">neq</option><option value="gt">gt</option><option value="gte">gte</option><option value="lt">lt</option><option value="lte">lte</option><option value="in">in</option><option value="contains">contains</option></select></label><label>Value type <select name="Rules[@index].ValueType"><option>string</option><option>number</option><option>boolean</option><option>datetime</option><option>string[]</option></select></label><button type="submit" name="removeRuleIndex" value="@index">Remove rule</button></div> }
    <button type="submit" name="command" value="add-rule">Add rule</button>
    </fieldset>
    @if (!isNew) { <label class="checkbox"><input asp-for="Enabled" /> Enabled</label> }
    <div class="form-actions"><button type="submit" class="button">Save</button><a href="@basePath">Cancel</a></div>
</form>
