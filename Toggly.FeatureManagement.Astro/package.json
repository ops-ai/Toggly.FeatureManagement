{
  "name": "@ops-ai/astro-feature-flags-toggly",
  "version": "1.12.0",
  "description": "Toggly feature flags SDK for Astro with SSR, SSG, and framework support",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./integration": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration/index.js"
    },
    "./client/setup": {
      "types": "./dist/client/setup.d.ts",
      "import": "./dist/client/setup.js"
    },
    "./client/store": {
      "types": "./dist/client/store.d.ts",
      "import": "./dist/client/store.js"
    },
    "./components/Feature.astro": "./dist/components/Feature.astro",
    "./components/FeatureClient.astro": "./dist/components/FeatureClient.astro",
    "./react": {
      "types": "./dist/frameworks/react/index.d.ts",
      "import": "./dist/frameworks/react/index.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue/index.d.ts",
      "import": "./dist/frameworks/vue/index.js"
    },
    "./vue/Feature.vue": "./dist/frameworks/vue/Feature.vue",
    "./vue/FeatureGateBuilder.vue": "./dist/frameworks/vue/FeatureGateBuilder.vue",
    "./svelte": {
      "types": "./dist/frameworks/svelte/index.d.ts",
      "import": "./dist/frameworks/svelte/index.js"
    },
    "./svelte/Feature.svelte": "./dist/frameworks/svelte/Feature.svelte",
    "./svelte/FeatureGateBuilder.svelte": "./dist/frameworks/svelte/FeatureGateBuilder.svelte"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && npm run copy-components",
    "copy-components": "mkdir -p dist/components dist/frameworks/vue dist/frameworks/svelte && cp src/components/*.astro dist/components/ && cp src/frameworks/vue/*.vue dist/frameworks/vue/ && cp src/frameworks/svelte/*.svelte dist/frameworks/svelte/",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "astro",
    "feature-flags",
    "toggly",
    "feature-toggle",
    "ssr",
    "ssg",
    "feature-management"
  ],
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Astro"
  },
  "dependencies": {
    "@ops-ai/toggly-eval": "^2.0.0",
    "@ops-ai/toggly-hooks-types": "^1.4.3",
    "@ops-ai/toggly-local-gates": "^1.0.1",
    "@ops-ai/toggly-signed-defs": "^1.2.3",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@nanostores/react": "^1.0.0",
    "@nanostores/vue": "^1.0.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.7",
    "@types/ws": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "astro": "^5.16.0",
    "jsdom": "^23.0.0",
    "react": "^19.2.3",
    "svelte": "^5.46.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.26",
    "ws": "^8.0.0"
  },
  "peerDependencies": {
    "@nanostores/react": "^1.0.0",
    "@nanostores/svelte": "^0.10.0",
    "@nanostores/vue": "^1.0.0",
    "astro": "^5.0.0",
    "nanostores": "^1.0.0",
    "react": ">=18.0.0",
    "svelte": ">=4.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@nanostores/react": {
      "optional": true
    },
    "@nanostores/svelte": {
      "optional": true
    },
    "@nanostores/vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "homepage": "https://docs.toggly.io/sdks/astro",
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
