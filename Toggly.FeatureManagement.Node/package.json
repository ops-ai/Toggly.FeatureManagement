{
  "name": "toggly-node-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Toggly Node.js Server SDKs monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Node"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./toggly-*\" build",
    "test": "pnpm -r --filter \"./toggly-*\" test",
    "lint": "pnpm -r --filter \"./toggly-*\" lint",
    "clean": "pnpm -r --filter \"./toggly-*\" clean",
    "typecheck": "pnpm -r --filter \"./toggly-*\" typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/ws": "^8.18.2",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.72.1",
    "typescript": "^5.9.3",
    "ws": "^8.22.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
