{
  "name": "@ops-ai/nuxt-toggly-server",
  "version": "1.4.0",
  "description": "Server-side feature flag utilities for Nuxt with Nitro support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "toggly",
    "nuxt",
    "nitro",
    "server",
    "typescript",
    "feature-management"
  ],
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Nuxt/nuxt-toggly-server"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://docs.toggly.io/sdks/nuxt/server",
  "dependencies": {
    "@ops-ai/nuxt-toggly-core": "workspace:^",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@ops-ai/nuxt-toggly-core": "^1.9.0",
    "h3": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.19.0",
    "h3": "^1.14.0",
    "typescript": "^5.7.3",
    "unbuild": "^3.4.0",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
