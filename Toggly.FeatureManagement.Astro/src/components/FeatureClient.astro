---
/**
 * FeatureClient - Client-side hydrated feature flag component
 *
 * This component evaluates feature flags on the client side using Astro islands.
 * Use `negate` for the off path. Use a separate Feature with negate instead of a fallback slot.
 *
 * @example Basic usage with client:load
 * ```astro
 * <FeatureClient flag="new-feature" client="load">
 *   <p>This content hydrates and checks the flag on the client</p>
 * </FeatureClient>
 * ```
 *
 * @example Off path with negate
 * ```astro
 * <FeatureClient flag="maintenance-mode" negate={true} client="load">
 *   <MainApp />
 * </FeatureClient>
 * ```
 */

interface Props {
  /** Feature flag key to check */
  flag: string;
  /** Hydration strategy: 'load', 'idle', or 'visible' (default: 'load') */
  client?: 'load' | 'idle' | 'visible';
  /** Requirement for multiple flags: 'all' or 'any' (default: 'all') */
  requirement?: 'all' | 'any';
  /** If true, negates the result (default: false) */
  negate?: boolean;
  /** Entity instance or canonical entity context for entity-gated flags */
  context?: import('@ops-ai/toggly-hooks-types').TogglyEntityContext | Record<string, unknown> | null;
  /** Context kind for registerContext mapper lookup when `context` is a domain object */
  contextKind?: string;
}

const { flag, client = 'load', requirement = 'all', negate = false, contextKind } = Astro.props;
---

<div
  data-toggly-feature={flag}
  data-toggly-requirement={requirement}
  data-toggly-negate={negate}
  data-toggly-context-kind={contextKind}
  data-toggly-context={Astro.props.context ? JSON.stringify(Astro.props.context) : undefined}
  data-toggly-hydrate={client}
  class="toggly-feature-client"
>
  <div data-toggly-content style="display: none;">
    <slot />
  </div>
</div>

<script>
  import {hydrateFeatureClients, cleanupFeatureClients} from '../client/feature-clients.js';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hydrateFeatureClients, {once: true});
  } else {
    hydrateFeatureClients();
  }
  document.addEventListener('astro:page-load', hydrateFeatureClients);
  document.addEventListener('astro:before-swap', cleanupFeatureClients);
</script>

<style>
  .toggly-feature-client {
    display: contents;
  }
</style>
