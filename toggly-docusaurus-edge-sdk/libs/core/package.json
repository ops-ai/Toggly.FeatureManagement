{
  "name": "@ops-ai/toggly-client-core",
  "version": "0.2.0",
  "description": "Framework-agnostic Toggly client for feature flag evaluation",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "toggly",
    "feature-flags",
    "feature-toggles",
    "feature-management"
  ],
  "author": "Toggly",
  "license": "MIT",
  "dependencies": {
    "@ops-ai/toggly-hooks-types": "^1.4.3",
    "@ops-ai/toggly-signed-defs": "^1.2.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
