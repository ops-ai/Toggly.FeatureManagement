{
  "schemaVersion": 1,
  "options": {
    "appKey": "test-app",
    "environment": "Production"
  },
  "policy": {
    "endpoint": "https://metrics.toggly.io/api/frontend/telemetry",
    "flushIntervalMs": 45000,
    "minimumIntervalMs": 30000,
    "maximumIntervalMs": 60000,
    "jitterFraction": 0.2,
    "maxEnvelopeBytes": 49152,
    "maxBufferedBytes": 262144,
    "maxEntries": 2000,
    "maxVariantsPerFeature": 16,
    "maxValue": 1000000,
    "timeoutMs": 5000,
    "retryDelaysMs": [
      30000,
      60000
    ],
    "expiryMs": 300000,
    "ackStatus": 202,
    "retryStatuses": [
      429,
      503
    ],
    "dropStatuses": [
      200,
      204,
      400,
      401,
      403,
      413,
      500
    ]
  },
  "scenarios": [
    {
      "name": "aggregate-and-trim",
      "events": [
        [
          "recordCheck",
          "checkout",
          "enabled"
        ],
        [
          "recordCheck",
          "checkout",
          "enabled"
        ],
        [
          "recordUsage",
          "checkout",
          "enabled"
        ],
        [
          "recordView",
          "checkout",
          "disabled"
        ],
        [
          "incrementCounter",
          "orders",
          2
        ],
        [
          "incrementCounter",
          "orders",
          3
        ],
        [
          "setGauge",
          "cart",
          9
        ],
        [
          "setGauge",
          "cart",
          4
        ]
      ],
      "envelopes": [
        {
          "k": "test-app",
          "e": "Production",
          "f": {
            "checkout": {
              "enabled": [
                2,
                1
              ],
              "disabled": [
                0,
                0,
                1
              ]
            }
          },
          "m": {
            "orders": 5,
            "cart": 4
          }
        }
      ]
    },
    {
      "name": "prototype-safe-default-variant",
      "events": [
        [
          "recordUsage",
          "__proto__"
        ],
        [
          "recordView",
          "constructor"
        ],
        [
          "incrementCounter",
          "__proto__",
          1
        ]
      ],
      "envelopes": [
        {
          "k": "test-app",
          "e": "Production",
          "f": {
            "__proto__": {
              "enabled": [
                0,
                1
              ]
            },
            "constructor": {
              "enabled": [
                0,
                0,
                1
              ]
            }
          },
          "m": {
            "__proto__": 1
          }
        }
      ]
    },
    {
      "name": "counter-split",
      "events": [
        [
          "incrementCounter",
          "orders",
          2000001
        ]
      ],
      "envelopes": [
        {
          "k": "test-app",
          "e": "Production",
          "m": {
            "orders": 1000000
          }
        },
        {
          "k": "test-app",
          "e": "Production",
          "m": {
            "orders": 1000000
          }
        },
        {
          "k": "test-app",
          "e": "Production",
          "m": {
            "orders": 1
          }
        }
      ]
    },
    {
      "name": "invalid-and-conflicting-metrics",
      "events": [
        [
          "incrementCounter",
          "orders",
          2
        ],
        [
          "setGauge",
          "orders",
          9
        ],
        [
          "incrementCounter",
          "bad",
          -1
        ],
        [
          "incrementCounter",
          "fraction",
          1.5
        ],
        [
          "setGauge",
          "too-large",
          1000001
        ],
        [
          "setGauge",
          " ",
          2
        ],
        [
          "recordCheck",
          "",
          "enabled"
        ]
      ],
      "envelopes": [
        {
          "k": "test-app",
          "e": "Production",
          "m": {
            "orders": 2
          }
        }
      ]
    },
    {
      "name": "disabled",
      "options": {
        "enableTelemetry": false
      },
      "events": [
        [
          "recordUsage",
          "checkout"
        ]
      ],
      "envelopes": []
    },
    {
      "name": "no-key",
      "options": {
        "appKey": ""
      },
      "events": [
        [
          "recordUsage",
          "checkout"
        ]
      ],
      "envelopes": []
    }
  ],
  "transportScenarios": [
    {
      "name": "retry-exhaustion",
      "statuses": [
        429,
        503,
        503
      ],
      "attemptTimesMs": [
        0,
        30000,
        90000
      ]
    },
    {
      "name": "retry-success",
      "statuses": [
        503,
        202
      ],
      "attemptTimesMs": [
        0,
        30000
      ]
    },
    {
      "name": "long-retry-after",
      "statuses": [
        429,
        202
      ],
      "retryAfter": "120",
      "attemptTimesMs": [
        0,
        120000
      ]
    },
    {
      "name": "expired-retry-after",
      "statuses": [
        429
      ],
      "retryAfter": "301",
      "attemptTimesMs": [
        0
      ]
    },
    {
      "name": "ambiguous-network",
      "failure": "network",
      "attemptTimesMs": [
        0
      ]
    },
    {
      "name": "timeout",
      "failure": "timeout",
      "attemptTimesMs": [
        0
      ]
    }
  ],
  "invariants": [
    {
      "name": "privacy",
      "actions": [
        "Supply identity, claims, groups, entity, definitions URL query and auth headers to SDK",
        "Record one check and flush"
      ],
      "expected": [
        "Body has only k,e,f,m fields",
        "Only Content-Type and optional Content-Encoding headers",
        "Credentials omitted; no fabricated Origin",
        "No identity, timestamps, instance or metric kind in body"
      ]
    },
    {
      "name": "snapshot-order",
      "actions": [
        "Set gauge cart=1",
        "Start flush and hold its response",
        "Set gauge cart=2",
        "Call flush again",
        "Acknowledge old request with 202"
      ],
      "expected": [
        "One request at a time",
        "First envelope cart=1, second envelope cart=2",
        "Older retry remains before newer gauge"
      ]
    },
    {
      "name": "resource-bounds",
      "actions": [
        "Hold first request open",
        "Record entries until limits reached",
        "Attempt an additional entry",
        "Acknowledge and drain"
      ],
      "expected": [
        "At most 2000 accepted entries across pending/inflight",
        "At most 262144 UTF-8 buffered bytes across pending/inflight",
        "No previously accepted entry evicted",
        "Every envelope at most 49152 uncompressed UTF-8 bytes",
        "At most 16 variants per feature",
        "Individual oversized entry rejected"
      ]
    },
    {
      "name": "lifecycle",
      "actions": [
        "Create disabled or no-key reporter",
        "Attach lifecycle",
        "Dispose",
        "Create enabled reporter, record event, trigger hidden/background",
        "Detach and dispose enabled reporter"
      ],
      "expected": [
        "Disabled owner has no queue, listeners, timers or requests",
        "Background initiates best-effort flush",
        "Disposal is synchronous, detaches listeners, cancels periodic/retry timers",
        "No retry after disposal; final attempt bounded by 5000ms"
      ]
    },
    {
      "name": "compression",
      "actions": [
        "Ordinary flush with native gzip support",
        "Simulate pre-send compression failure",
        "Simulate ambiguous compressed request failure",
        "Exit flush"
      ],
      "expected": [
        "Ordinary request uses gzip",
        "Compression failure falls back to JSON before request",
        "Ambiguous request is not retried as plain",
        "Exit request uses uncompressed keepalive where supported"
      ]
    }
  ]
}
