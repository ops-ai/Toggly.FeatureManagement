{
  "name": "@ops-ai/toggly-client-telemetry",
  "version": "1.1.0",
  "description": "Portable bounded frontend telemetry for Toggly client SDKs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/esm/browser.d.ts",
        "default": "./dist/esm/browser.js"
      },
      "require": {
        "types": "./dist/cjs/browser.d.ts",
        "default": "./dist/cjs/browser.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:packed": "node tests/packed.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "toggly",
    "feature-flags",
    "feature-management",
    "telemetry",
    "typescript"
  ],
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "toggly-client-telemetry"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://docs.toggly.io/sdks",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0",
    "typescript-4-8": "npm:typescript@^4.8.4",
    "typescript-4-9": "npm:typescript@^4.9.5"
  },
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "browser": [
        "dist/cjs/browser.d.ts"
      ]
    }
  }
}
