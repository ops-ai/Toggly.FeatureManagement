{
  "name": "@ops-ai/nextjs-toggly-server",
  "version": "1.9.0",
  "description": "Server-side feature flags for Next.js - Server Components, Server Actions, and Route Handlers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nextjs",
    "feature-flags",
    "feature-toggles",
    "toggly",
    "typescript",
    "server-components",
    "server-actions",
    "rsc",
    "feature-management"
  ],
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Next/nextjs-toggly-server"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://docs.toggly.io/sdks/nextjs/server",
  "dependencies": {
    "@ops-ai/nextjs-toggly-core": "workspace:^",
    "@ops-ai/toggly-segments": "^0.1.0",
    "ws": "^8.22.1"
  },
  "optionalDependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.7.15"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.7.15",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
