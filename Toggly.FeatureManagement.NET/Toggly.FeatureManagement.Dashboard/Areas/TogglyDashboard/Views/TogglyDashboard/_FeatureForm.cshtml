@model DashboardFeatureInput
@{
    var mount = (string?)ViewData["DashboardMount"] ?? "";
    var basePath = $"{Context.Request.PathBase}{mount}";
    var isNew = Model.IsNew;
    var readOnly = ViewData["ReadOnly"] as bool? ?? false;
}
<form method="post" action="@(isNew ? basePath + "/features/create" : basePath + "/features/save")" class="card form-card settings-card" data-unsaved-warning>
    <input type="hidden" name="__RequestVerificationToken" value="@ViewData["AntiforgeryToken"]" />
    <div asp-validation-summary="All" class="validation-summary" tabindex="-1" role="alert"></div>
    <input type="hidden" asp-for="ExpectedRevision" />
    <input type="hidden" asp-for="IsNew" />
    <h2>Basic Information</h2>
    <label for="Key">Feature Key</label>
    <input asp-for="Key" id="Key" autocomplete="off" readonly="@(!isNew)" />
    <span asp-validation-for="Key"></span>
    <label for="Name">Feature Name</label>
    <input asp-for="Name" id="Name" autocomplete="off" />
    <span asp-validation-for="Name"></span>
    <label for="Description">Description</label>
    <textarea asp-for="Description" id="Description" rows="4"></textarea>
    <span asp-validation-for="Description"></span>
    <label for="Category">Category</label>
    <input asp-for="Category" id="Category" autocomplete="off" />
    <span asp-validation-for="Category"></span>
    <label for="Tags">Tags</label>
    <textarea asp-for="Tags" id="Tags" rows="2"></textarea>
    <p class="hint">One tag per line. Literal commas are preserved.</p>
    <label for="ContextKind">Entity context kind</label>
    <select asp-for="ContextKind" id="ContextKind">
        <option value="">No entity context</option>
        @foreach (var kind in ((IEnumerable<string>?)ViewData["ContextKinds"] ?? []).Append(Model.ContextKind ?? "").Where(kind => kind.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            <option value="@kind">@kind</option>
        }
    </select>
    @if (readOnly) { <p role="status">Editing is unavailable in the current storage or read-only mode.</p> }
    <div class="form-actions">
        <button type="submit" class="button" disabled="@readOnly">Save</button>
        <a href="@basePath/">Cancel</a>
        @if (!isNew)
        {
            <a class="danger-link" href="@basePath/features/delete?key=@Uri.EscapeDataString(Model.Key)">Delete</a>
        }
    </div>
</form>
