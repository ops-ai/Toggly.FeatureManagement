<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Same matrix as Client. Desktop is pure managed crypto/IO (no ASP.NET); netstandard2.1 still omitted
         with Client because signature helpers use Convert.ToHexString / HashData without extra packages. -->
    <TargetFrameworks>net7.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Toggly</Authors>
    <Description>Verified frontend feature evaluation for .NET client applications.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ops-ai/Toggly.FeatureManagement</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Toggly.FeatureManagement.Client/Toggly.FeatureManagement.Client.csproj" />
  </ItemGroup>
</Project>
