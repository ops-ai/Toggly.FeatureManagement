{
  "name": "@ops-ai/remix-toggly-server",
  "version": "1.0.0",
  "description": "Server-side utilities for Toggly Remix SDK - loaders, actions, and server utilities",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "remix",
    "feature-flags",
    "feature-toggles",
    "toggly",
    "server",
    "loader",
    "action"
  ],
  "author": "OpsAI <support@ops.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://github.com/ops-ai/Toggly.FeatureManagement#readme",
  "dependencies": {
    "@ops-ai/remix-toggly-core": "file:../remix-toggly-core"
  },
  "peerDependencies": {
    "@remix-run/node": ">=2.0.0",
    "@remix-run/server-runtime": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@remix-run/node": {
      "optional": true
    },
    "@remix-run/server-runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@remix-run/node": "^2.0.0",
    "@remix-run/server-runtime": "^2.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "ts-jest": "^29.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
