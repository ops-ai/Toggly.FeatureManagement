{
  "name": "@ops-ai/svelte-feature-flags-toggly",
  "version": "1.11.0",
  "description": "Provides feature flags support for Svelte applications allowing you to enable and disable features easily. Can be used with or without Toggly.io.",
  "type": "module",
  "main": "./dist/svelte-feature-flags-toggly.cjs",
  "module": "./dist/svelte-feature-flags-toggly.es.js",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "svelte": "./src/index.ts",
      "import": "./dist/svelte-feature-flags-toggly.es.js",
      "require": "./dist/svelte-feature-flags-toggly.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "src/index.ts",
    "src/components",
    "src/services",
    "src/stores",
    "src/utils"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist/types && cp src/components/*.svelte dist/types/components/",
    "prepublishOnly": "npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "test:host": "node scripts/test-host.mjs && npm run test:browser-host",
    "test:browser-host": "node scripts/test-browser-host.mjs"
  },
  "keywords": [
    "svelte",
    "feature-flags",
    "feature-toggles",
    "toggly",
    "ab-testing",
    "feature-management"
  ],
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Svelte/svelte-feature-flags-toggly"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://docs.toggly.io/sdks/javascript/svelte",
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.3.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.0.0",
    "@vitest/coverage-v8": "^3.1.0",
    "jsdom": "^28.0.0",
    "svelte": "^5.53.0",
    "svelte-check": "^3.6.0",
    "typescript": "^5.0.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "ws": "^8.0.0"
  },
  "dependencies": {
    "@ops-ai/toggly-client-telemetry": "^1.1.0",
    "@ops-ai/toggly-hooks-types": "^1.4.5",
    "@ops-ai/toggly-local-gates": "^1.0.1",
    "@ops-ai/toggly-signed-defs": "^1.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
