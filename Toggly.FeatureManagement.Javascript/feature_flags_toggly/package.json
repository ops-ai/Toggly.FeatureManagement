  "files": [
    "dist"
  ],
  "dependencies": {
    "@ops-ai/toggly-client-telemetry": "^1.3.0",
    "@ops-ai/toggly-hooks-types": "^1.4.6",
    "@ops-ai/toggly-local-gates": "^1.0.2",
    "@ops-ai/toggly-signed-defs": "^1.2.10",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "cross-fetch": "^4.1.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "ws": "^8.22.1"
