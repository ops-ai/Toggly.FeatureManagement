<Project>
  <PropertyGroup>
    <Version>3.15.0</Version>
    <!-- Embedded into assemblies via Directory.Build.targets (GenerateAssemblyInfo is false). -->
    <!-- All SDK families inherit this version; project overrides are rejected by CI. -->
    <!-- Suppress warnings about packages not supporting older target frameworks -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <Authors>Toggly</Authors>
    <Company>Toggly</Company>
    <PackageProjectUrl>https://toggly.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ops-ai/Toggly.FeatureManagement</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>toggly-package-icon.png</PackageIcon>
    <PackageTags>toggly;feature-flags;feature-management</PackageTags>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Portable PDBs stay in the .nupkg so nuget.info / Package Explorer can
         validate Source Link, Deterministic, and Compiler Flags without the
         separate symbol server. snupkg remains for nuget.org symbol feed. -->
    <DebugType>portable</DebugType>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TF_BUILD)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true' Or '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <!--
    net11.0 is RC. Projects append $(TogglyNet11Tfm) to TargetFrameworks so the
    TFM is present for local builds and the allow-failure preview job
    (IncludeNet11Preview=true), but omitted from required CI restore/build/pack.
    Do not strip TargetFrameworks late in Directory.Build.targets — that leaves a
    semicolon list in TargetFramework and triggers NETSDK1046.
  -->
  <PropertyGroup>
    <TogglyNet11Tfm>;net11.0</TogglyNet11Tfm>
    <TogglyNet11Tfm Condition="'$(ExcludeNet11Preview)' == 'true' Or ('$(CI)' == 'true' And '$(IncludeNet11Preview)' != 'true')"></TogglyNet11Tfm>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets/toggly-package-icon.png" Pack="true" PackagePath="\" Condition="'$(IsPackable)' != 'false'" />
  </ItemGroup>
</Project>
