{
  "name": "@ops-ai/react-native-toggly-storage-mmkv4",
  "version": "1.0.0",
  "description": "MMKV 4 Nitro storage adapter for the React Native Toggly SDK.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "toggly",
    "feature-flags",
    "mmkv",
    "nitro",
    "storage",
    "persistence"
  ],
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.ReactNative/libs/storage-mmkv4"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "homepage": "https://docs.toggly.io/sdks/react-native/storage",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ops-ai/react-native-toggly-core": "^1.7.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^19.1.1",
    "jest": "^29.7.0",
    "react": "^19.2.3",
    "react-native": "0.87.1",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react-native-mmkv": "^4.0.0",
    "react-native-nitro-modules": "^0.37.1"
  }
}
