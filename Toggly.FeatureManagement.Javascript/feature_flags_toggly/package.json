{
  "name": "@ops-ai/feature-flags-toggly",
  "version": "1.11.0",
  "description": "Provides feature flags support for Javascript applications allowing you to enable and disable features easily. Can be used with or without Toggly.io.",
  "main": "./dist/feature-flags-toggly.bundle.js",
  "module": "./dist/feature-flags-toggly.bundle.js",
  "types": "./dist/feature-flags-toggly.bundle.d.ts",
  "exports": {
    ".": {
      "types": "./dist/feature-flags-toggly.bundle.d.ts",
      "import": "./dist/feature-flags-toggly.bundle.js",
      "require": "./dist/feature-flags-toggly.bundle.js",
      "default": "./dist/feature-flags-toggly.bundle.js"
    }
  },
  "scripts": {
    "build": "webpack && tsc -p tsconfig.types.json",
    "dev": "npx webpack -w",
    "test": "npx jest",
    "test:browser-host": "node tests/packed-browser-host.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Javascript/feature_flags_toggly"
  },
  "author": "Toggly <support@toggly.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
