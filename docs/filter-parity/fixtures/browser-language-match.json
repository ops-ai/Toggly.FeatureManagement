{
  "id": "browser-language-match",
  "description": "BrowserLanguage matches when Accept-Language contains the configured value",
  "featureKey": "parity-browser-language",
  "requirementType": "Any",
  "filters": [
    {
      "name": "BrowserLanguage",
      "parameters": {
        "Percentage": 100,
        "BrowserLanguage:0": "en-US"
      }
    }
  ],
  "context": {
    "identity": "u",
    "request": {
      "acceptLanguage": "en-US,en;q=0.9"
    }
  },
  "expected": true
}
