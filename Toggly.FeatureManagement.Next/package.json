{
  "name": "@ops-ai/nextjs-toggly-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Feature flags for Next.js - monorepo",
  "scripts": {
    "test:hosts": "node --test scripts/host-resources.test.mjs && node scripts/test-hosts.mjs",
    "build": "pnpm -r --filter \"./nextjs-*\" build",
    "test": "pnpm -r --filter \"./nextjs-*\" test",
    "test:coverage": "pnpm -r --filter \"./nextjs-*\" test:coverage",
    "lint": "pnpm -r --filter \"./nextjs-*\" lint",
    "typecheck": "pnpm -r --filter \"./nextjs-*\" typecheck",
    "clean": "pnpm -r --filter \"./nextjs-*\" clean",
    "dev:prepare": "pnpm -r --filter \"./nextjs-*\" dev:prepare"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript-eslint": "^8.72.1",
    "ws": "^8.22.1"
  }
}
