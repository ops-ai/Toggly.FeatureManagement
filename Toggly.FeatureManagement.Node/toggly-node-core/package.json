{
  "name": "@ops-ai/toggly-node-core",
  "version": "0.1.1",
  "description": "Core Toggly feature flags SDK for Node.js - zero browser dependencies",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "toggly",
    "nodejs",
    "server-side",
    "feature-management",
    "experimentation",
    "a-b-testing"
  ],
  "author": "OpsAI <support@ops.ai>",
  "license": "MIT",
  "homepage": "https://toggly.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement.git",
    "directory": "Toggly.FeatureManagement.Node/toggly-node-core"
  },
  "bugs": {
    "url": "https://github.com/ops-ai/Toggly.FeatureManagement/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "@types/ws": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.18.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
